# Product source
# Point this at the admin/backend API that powers the Products admin panel.
# When omitted, the site uses the existing local catalogue in src/data/products.js.
VITE_API_URL=

# Optional: products endpoint path (defaults to /products)
# VITE_PRODUCTS_PATH=/products

# Optional: use a full products endpoint URL instead of VITE_API_URL + path
# VITE_PRODUCTS_URL=https://your-api.example.com/products

# Optional: disable the local catalogue fallback once the API is live
# VITE_DISABLE_LOCAL_PRODUCTS=true

# Contact enquiry form
# The Contact page posts enquiries to the backend at
# POST http://localhost:5000/api/enquiries with
# ({ name, email, phone, message, source }).
# The backend URL is configured in src/api.js.
